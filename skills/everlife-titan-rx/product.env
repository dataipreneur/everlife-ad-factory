# Product settings read by core/scripts/preflight.sh. One file per product skill.
# PRODUCT_NAME = the name on creative and the Marketing Studio title ("Titan-Rx": the bible's CTA spelling; its heading reads
# "Titan-rx", the label "TITAN-RX"; Justin to confirm one spelling).
PRODUCT_NAME="Titan-Rx"
OUT_DIR="$HOME/Everlife-Creative/output/Titan-Rx"
COPY_LOG="$HOME/Everlife-Creative/titan-rx-copy-log.md"
BOTTLE="titan-rx_bottle.png"
PILL="titan-rx_capsule.png"
RENDERS="titan-rx_bottle.png titan-rx_bottle_ref.jpg titan-rx_capsule.png titan-rx_capsule_ref.jpg"
DRIVE_FOLDER="TABLETS-CAPSULES/TITAN-RX"
