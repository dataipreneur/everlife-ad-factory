PILL=""                                                        # topical cream: no tablet or capsule
RENDERS="ghk-cream_bottle.png ghk-cream_bottle_ref.jpg"
DRIVE_FOLDER="TABLETS-CAPSULES/GHK CREAM PEPTIDE"              # asset library (1CYPd3P2vpjUkkQvD2WPOJ0P_kcmy7HvP); local copy ~/Everlife-Creative/asset-library/
